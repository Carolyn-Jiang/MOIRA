# vLLM server; see README for server-side Qwen3 reasoning separation.
OPEN_SOURCE_BASE_URL=http://localhost:8000/v1
# Optional authenticated inference server:
# OPEN_SOURCE_API_KEY=
# Family-specific endpoints override the shared endpoint:
# LLAMA_BASE_URL=http://localhost:8000/v1
# QWEN_BASE_URL=http://localhost:8001/v1
# LLAMA_API_KEY=
# QWEN_API_KEY=
OPEN_SOURCE_MAX_TOKENS=16384
OPEN_SOURCE_TIMEOUT=600
OPEN_SOURCE_SEND_SEED=1
OPEN_SOURCE_REQUEST_ATTEMPTS=3
OPEN_SOURCE_RETRY_DELAY=120
OPEN_SOURCE_EXTRA_BODY={}
# Prefer --thinking on/off per Qwen3 batch; do not set a shared mode for Llama.
# OPEN_SOURCE_THINKING=on
# Qwen server must use --reasoning-parser qwen3 in BOTH modes.

# Hosted APIs: fill only the key for the provider you will run.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Optional provider-specific overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_TOKENS=4096
# OPENAI_REASONING_EFFORT=low
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_THINKING=disabled
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_REASONING_EFFORT=low
# GEMINI_MAX_TOKENS=4096
